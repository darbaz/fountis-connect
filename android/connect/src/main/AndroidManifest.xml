<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only asked at runtime (API 33+) when the app calls FountisConnect.enableNotifications(activity). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- The full-screen FOUNTIS survey. Not exported; opened only by the SDK. -->
        <activity
            android:name="org.fountis.connect.FountisSurveyActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|locale|fontScale"
            android:enableOnBackInvokedCallback="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/FountisConnect.Survey"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
